// The Gilune processor contract, v0.1 — the public seam between the
// kernel and any processor implementation: bundled, sandboxed
// (ADR 0003), or external over the FFI (ADR 0018 § 2). All three are
// the same contract in different transports; the README says what the
// FFI route's streamed subject-blob changes and what it does not.
// Namespaces are permanently project-neutral (org:memory).
//
// The host import is shaped like a scoped `objects.read` grant: a
// processor sees its job's subject and nothing else. Outputs are
// proposals; the kernel owns committing them idempotently with
// provenance. Handlers run at-least-once and must be deterministic
// enough that recovery failures are distinguishable from provider
// variation.

package org:memory@0.1.0;

interface host-objects {
    // The subject's current head payload (canonical JSON document).
    subject-payload: func() -> result<string, string>;
    // Which revision `subject-payload` answered with — the head this
    // processor actually read. Handing it back as an output's
    // `expected-head` is how a slow processor declines to overwrite an
    // answer that landed while it was working. `none` only for a subject
    // with no head at all.
    //
    // The host reads this and the payload from one head row, so the pair
    // is always one revision's: two separate reads with a write between
    // them would give the old document under the new head, and the
    // compare-and-set would then pass over the very answer it protects.
    subject-head: func() -> result<option<string>, string>;
    // The subject's original blob bytes, digest-verified by the host.
    subject-blob: func() -> result<list<u8>, string>;
}

interface handler {
    record job {
        event-id: string,
        event-type: string,
        subject-id: string,
        payload: string,
    }

    // Where an output lands. `new-object` is an interpretation of its
    // own, with provenance back to the subject; `revise-subject` is a new
    // revision of the subject's document, replacing its head (ADR 0013).
    enum output-target {
        new-object,
        revise-subject,
    }

    record proposed-output {
        // The output document's type, e.g. "org.memory.transcript". The
        // last segment names the vault folder and the `<type>-ready`
        // event. Ignored for `revise-subject`, which writes the subject's
        // own document and so keeps the subject's type.
        type-id: string,
        // Ignored for `revise-subject`, as type-id is.
        type-schema: s64,
        payload: string,
        target: output-target,
        // The subject head this output was written over, for a
        // `revise-subject` that would rather be refused than overwrite.
        // The host compares it inside the transaction that writes, so a
        // revision that landed while this processor ran refuses the
        // output rather than losing to it.
        //
        // `none` — the default, and the shape everything before this
        // carried — keeps the old behaviour: the output lands whatever
        // the subject has become. Ignored for `new-object`, which
        // replaces nothing.
        //
        // Additive and optional, so this is a compatible minor
        // (07-compatibility): a guest built against 0.1.0 without it is
        // unchanged, and a host reading `none` behaves exactly as it did.
        expected-head: option<string>,
    }

    process: func(j: job) -> result<list<proposed-output>, string>;
}

world processor {
    import host-objects;
    export handler;
}
