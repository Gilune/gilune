<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The widget's Record cell (ADR 0017 § 4). The microphone
         foreground service type is declared here AND passed to
         startForeground, and it must also be declared in Play Console. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- The recording notification is mandatory; on Android 13+ showing
         it needs the user's yes, which the app asks for beside the mic. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Two things, and the second one arrived with ADR 0019.
         (1) The transcription model (ADR 0017 § 4) — the only thing this
         app fetches from the internet. Holding the Android permission is
         not consent: the download waits on the plugin's own
         `network.request` grant, which always needs an explicit yes, and
         nothing is fetched because the app opened.
         (2) Sync with your own devices over the local network (ADR 0019
         § 1, § 2). A socket is bound only when sync is switched on in
         Settings, connections go only to devices that have been paired,
         and an unpaired device cannot complete the handshake at all.
         Capture, projection, editing and search still touch no socket. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Reading a pairing QR, and nothing else (ADR 0019 § 7). Asked for
         at the moment Scan is tapped, never at install, and declining it
         costs nothing: the six-digit code is on the same screen, so the
         camera is a convenience and never a condition of syncing. No
         frame is stored and none leaves the process — it is decoded in
         memory and dropped. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Whether this connection is metered, which is the whole of the
         caption model's "only download on Wi-Fi" default (ADR 0018 § 4).
         Declared HERE deliberately: the Moonshine AAR's own manifest
         merges this permission in whether we write it or not (R0
         condition 4), and a permission the app holds should be one
         somebody decided to hold. It reads a flag; it opens nothing. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Backup keeps the vault and leaves this device's identity behind
         (ADR 0019 § 4). Both files say the same thing on either side of
         API 31, and each carries its own reasoning: an identity that
         travels with a backup is a cloned identity with a shared sequence
         space, and the Keystore key that sealed it does not travel at all,
         so a restored copy of the file is one nothing on the new phone can
         open. Excluding `filesDir/sync` is what makes "a restored phone is
         a new device" a consequence of where the bytes live rather than a
         check somebody has to remember. -->
    <application
        android:label="Gilune"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:theme="@style/Theme.Gilune">

        <!-- The other half of that merge. The AAR declares an activity of
             its own, `MicrophonePermissionActivity`, which exists to ask
             for the microphone on behalf of `MicTranscriber` — the
             convenience wrapper that opens its own recorder and that this
             app deliberately never uses (ADR 0018 § 1: a tee, not a second
             microphone). Gilune asks for the microphone itself, beside the
             control that needs it, so this activity would be a second
             consent surface for a path that does not exist here. -->
        <activity
            android:name="ai.moonshine.voice.MicrophonePermissionActivity"
            tools:node="remove" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Launcher long-press shortcuts (§ 4's entry points that are
                 not the app, MB3). The shortcut intents are explicit, so
                 they need no filter of their own; the route travels as the
                 intent's action and `routeForAction` reads it. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Not exported, and with no intent filter: the only ways in are
             the widget's PendingIntent, its notification's Stop action,
             and the app itself. There is deliberately no boot receiver and
             no scheduler anywhere in this manifest (§ 4). -->
        <service
            android:name=".RecordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name=".GiluneWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="org.gilune.app.action.REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/gilune_widget_info" />
        </receiver>

        <!-- New note only. No microphone: a tile is not a documented
             exemption, so v1 ships the one action that needs none. -->
        <service
            android:name=".NewNoteTile"
            android:exported="true"
            android:icon="@drawable/ic_widget_new_note"
            android:label="@string/gilune_tile_new_note"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
