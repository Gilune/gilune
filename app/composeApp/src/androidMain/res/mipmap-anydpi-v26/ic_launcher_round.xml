<?xml version="1.0" encoding="utf-8"?>
<!--
The round variant, which is the same icon: an adaptive icon is already
masked by the launcher, so the round request is answered by the same three
layers rather than by a second drawing. Kept as its own file because
`android:roundIcon` names a resource and a launcher that asks for one
should get an answer.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/gilune_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
