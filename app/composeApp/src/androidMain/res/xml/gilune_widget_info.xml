<?xml version="1.0" encoding="utf-8"?>
<!--
`updatePeriodMillis` is zero on purpose: nothing about this widget is
background-initiated (ADR 0017 § 4). It redraws when the app refreshes
and when the recording service says something changed, never on a timer.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/gilune_widget"
    android:previewLayout="@layout/gilune_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/gilune_widget_description" />
